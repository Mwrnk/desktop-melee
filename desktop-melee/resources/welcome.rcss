/* Desktop Melee's welcome window on Windows and Linux
 * (docs/desktop-melee/ui-guide.md sections 9 to 11): the same dark look as
 * settings.rcss. Only bundled free fonts: Noto Sans (resources/menu*.ttf). */

div, p, h1, h2, h3 { display: block; }

body {
    font-family: "Noto Sans";
    font-size: 15dp;
    color: #e8e8f0;
    background-color: #141419;
    width: 100%;
    height: 100%;
    margin: 0;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
}

scrollbarvertical { width: 10dp; margin: 2dp 0; }
scrollbarvertical slidertrack { background-color: #00000000; }
scrollbarvertical sliderbar { background-color: #3a3a4a; border-radius: 5dp; min-height: 32dp; }
scrollbarvertical sliderarrowdec, scrollbarvertical sliderarrowinc { height: 0; }
scrollbarhorizontal { height: 0; }

.hidden { display: none; }

#top {
    display: flex;
    flex-direction: row;
    padding: 14dp 22dp 0;
    font-size: 13dp;
    color: #8a8a98;
}
#top .title { flex: 1; font-weight: bold; color: #b8b8c4; }

#body {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    padding: 12dp 26dp;
}
.step { display: none; }
.step.shown { display: block; }

h1 { font-size: 30dp; font-weight: bold; color: #ffffff; margin: 14dp 0 8dp; }
.lead { font-size: 16dp; line-height: 1.45; color: #b8b8c4; margin-bottom: 14dp; }
.small { font-size: 13dp; line-height: 1.4; color: #8a8a98; margin: 8dp 0; }

/* ---- Buttons ------------------------------------------------------------ */

#bottom { padding: 10dp 26dp 22dp; }
.primary {
    display: block;
    padding: 12dp 0;
    text-align: center;
    font-weight: bold;
    color: #ffffff;
    background-color: #3d75f5;
    border-radius: 10dp;
    cursor: pointer;
}
.primary:hover { background-color: #5585f7; }
.primary.disabled { color: #8a8a98; background-color: #2c2c38; }
.secondary {
    display: inline-block;
    padding: 7dp 16dp;
    border-radius: 15dp;
    background-color: #2c2c38;
    cursor: pointer;
}
.secondary:hover { background-color: #3a3a4a; }
#or-start { text-align: center; margin-top: 8dp; font-size: 13dp; color: #8a8a98; }

/* ---- Step 1: a drawing of a desktop ------------------------------------- */

#sketch {
    position: relative;
    height: 150dp;
    margin-top: 8dp;
    border-radius: 12dp;
    border: 2dp #3a3a4a;
    background-color: #1c2a4a;
}
#sketch .panel {
    position: absolute;
    left: 40dp;
    right: 40dp;
    bottom: 10dp;
    height: 18dp;
    border-radius: 9dp;
    background-color: #e8e8f0c0;
}
#sketch .fighter {
    position: absolute;
    bottom: 28dp;
    width: 18dp;
    height: 30dp;
    border-radius: 9dp;
}
#sketch .p1 { left: 110dp; background-color: #e83b38; }
#sketch .p2 { right: 110dp; background-color: #3d75f5; }
#sketch .edge {
    position: absolute;
    top: 6dp;
    bottom: 6dp;
    width: 2dp;
    background-color: #ff606080;
}
#sketch .left { left: 6dp; }
#sketch .right { right: 6dp; }

/* ---- Step 2: the disc --------------------------------------------------- */

#drop {
    margin: 6dp 0 12dp;
    padding: 22dp 14dp;
    text-align: center;
    border: 2dp #3a3a4a;
    border-radius: 12dp;
    background-color: #1a1a21;
}
#drop.over { border-color: #3d75f5; }
#drop .big { font-size: 17dp; font-weight: bold; margin-bottom: 4dp; }
#drop .types { font-size: 13dp; color: #8a8a98; margin-bottom: 12dp; }
#disc-status { min-height: 52dp; }
#disc-status .line { font-size: 14dp; }
#disc-status .name { font-size: 12dp; color: #8a8a98; margin-top: 2dp; }
#disc-status.ok .line { color: #4cd38a; font-weight: bold; }
#disc-status.bad .line { color: #ff7070; }

.bar {
    height: 8dp;
    margin: 8dp 0 4dp;
    border-radius: 4dp;
    background-color: #2c2c38;
}
.bar .fill {
    height: 8dp;
    width: 0%;
    border-radius: 4dp;
    background-color: #3d75f5;
}

/* ---- Step 3: controllers ------------------------------------------------ */

#cards { display: flex; flex-direction: row; margin: 6dp 0 12dp; }
#cards .card {
    flex: 1;
    margin: 0 3dp;
    padding: 10dp 6dp;
    text-align: center;
    border: 2dp #2a2a33;
    border-radius: 10dp;
    background-color: #1e1e26;
}
#cards .card.lit { border-color: #4cd38a; }
#cards .card .name { font-weight: bold; font-size: 14dp; }
#cards .card .sub { font-size: 11dp; color: #8a8a98; margin-top: 2dp; }
#card-keyboard { cursor: pointer; }
#card-keyboard:hover { background-color: #26262f; }

.listen-title { font-size: 12dp; font-weight: bold; color: #8a8a98; margin: 4dp 0 6dp; }
#pressed .slot {
    display: flex;
    flex-direction: row;
    align-items: center;
    padding: 7dp 10dp;
    margin-bottom: 4dp;
    border-radius: 8dp;
    background-color: #1e1e26;
}
#pressed .slot.empty { color: #55555f; }
#pressed .tag { width: 30dp; font-weight: bold; }
#pressed .p1 { color: #e83b38; }
#pressed .p2 { color: #3d75f5; }
#pressed .p3 { color: #e8c83b; }
#pressed .p4 { color: #4cd38a; }

#keys {
    margin: 8dp 0;
    padding: 8dp 12dp;
    border-radius: 10dp;
    background-color: #1e1e26;
    font-size: 13dp;
}
#keys .row { display: flex; flex-direction: row; padding: 3dp 0; }
#keys .what { width: 70dp; color: #8a8a98; }
.cap {
    display: inline-block;
    padding: 1dp 6dp;
    margin-right: 4dp;
    border-radius: 4dp;
    border: 1dp #55555f;
    background-color: #2c2c38;
    font-size: 12dp;
}

/* ---- Step 5: the tray --------------------------------------------------- */

#tray-sketch {
    display: flex;
    flex-direction: row;
    align-items: center;
    height: 44dp;
    margin-top: 10dp;
    padding: 0 12dp;
    border-radius: 10dp;
    background-color: #1e1e26;
    font-size: 12dp;
    color: #8a8a98;
}
#tray-sketch .spacer { flex: 1; }
#tray-sketch .icon {
    position: relative;
    width: 26dp;
    height: 26dp;
    margin-right: 10dp;
    border-radius: 6dp;
    background-color: #3a3a4a;
}
#tray-sketch .icon .floor {
    position: absolute; left: 3dp; right: 3dp; bottom: 4dp; height: 4dp;
    border-radius: 2dp; background-color: #eeeef2;
}
#tray-sketch .icon .f1, #tray-sketch .icon .f2 {
    position: absolute; bottom: 8dp; width: 6dp; height: 10dp; border-radius: 3dp;
}
#tray-sketch .icon .f1 { left: 6dp; background-color: #e83b38; }
#tray-sketch .icon .f2 { right: 6dp; background-color: #3d75f5; }
